# Server Configuration
NODE_ENV=development
PORT=5000
HOST=localhost

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=simbi_ke
DB_USER=postgres
DB_PASSWORD=your_password
DB_POOL_SIZE=20
DB_IDLE_TIMEOUT=30000

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# JWT Configuration
JWT_SECRET=your_super_secret_jwt_key_change_in_production
JWT_EXPIRY=30m
JWT_REFRESH_EXPIRY=7d

# Session Configuration
SESSION_TIMEOUT=1800000
REMEMBER_ME_DAYS=30

# OTP Configuration
OTP_LENGTH=6
OTP_EXPIRY=600

# Payment Configuration
MPESA_CONSUMER_KEY=your_mpesa_key
MPESA_CONSUMER_SECRET=your_mpesa_secret
MPESA_PASSKEY=your_mpesa_passkey
MPESA_SHORTCODE=174379
MPESA_INITIATOR_NAME=initiator_name
MPESA_INITIATOR_PASSWORD=encrypted_password
MPESA_ENVIRONMENT=sandbox

AIRTEL_API_KEY=your_airtel_key
AIRTEL_API_URL=https://api.airtel.africa/merchant/v1/payments

# SMS Configuration
AFRICASTALKING_API_KEY=your_africatalking_key
AFRICASTALKING_USERNAME=SimbiKE

# Geolocation
GEOLOCATION_API_KEY=optional_geolocation_key

# System
SYSTEM_COLLECTION_MPESA=254708140269
SYSTEM_REVENUE_PERCENTAGE=5
WITHDRAWAL_FEE_PERCENTAGE=10
DEPOSIT_VAT_PERCENTAGE=5

# Logging
LOG_LEVEL=debug
LOG_FILE=logs/app.log

# CORS
ALLOWED_ORIGINS=http://localhost:3000,https://simbi-ke.com

# Admin
ADMIN_PANEL_SECRET=admin_secret_key
