# Server Configuration
NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:3000

# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=simbi_ke
DB_USER=postgres
DB_PASSWORD=your_secure_password
DB_POOL_MIN=5
DB_POOL_MAX=20

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Authentication
JWT_SECRET=your-super-secret-jwt-key-min-32-chars
JWT_EXPIRES_IN=30m
REFRESH_TOKEN_EXPIRES_IN=30d
OTP_EXPIRY_SECONDS=600
OTP_LENGTH=6

# M-Pesa Configuration
MPESA_CONSUMER_KEY=your_mpesa_consumer_key
MPESA_CONSUMER_SECRET=your_mpesa_consumer_secret
MPESA_SHORTCODE=123456
MPESA_PASSKEY=your_mpesa_passkey
MPESA_CALLBACK_URL=https://api.simbike.ke/payments/mpesa/callback
MPESA_ENVIRONMENT=sandbox

# Airtel Money Configuration
AIRTEL_CLIENT_ID=your_airtel_client_id
AIRTEL_CLIENT_SECRET=your_airtel_client_secret
AIRTEL_API_KEY=your_airtel_api_key
AIRTEL_CALLBACK_URL=https://api.simbike.ke/payments/airtel/callback
AIRTEL_ENVIRONMENT=sandbox

# SMS Gateway (Twilio or AfriSpeech)
SMS_PROVIDER=twilio
TWILIO_ACCOUNT_SID=your_twilio_sid
TWILIO_AUTH_TOKEN=your_twilio_token
TWILIO_FROM_NUMBER=+254XXXXXXXXX

# IP Geolocation
MAXMIND_LICENSE_KEY=your_maxmind_key

# Payment Settings
DEPOSIT_VAT_PERCENTAGE=5
WITHDRAWAL_FEE_PERCENTAGE=10
WITHDRAWAL_COLLECTION_ACCOUNT=254708140269
MIN_DEPOSIT=10
MAX_DEPOSIT=50000
MIN_WITHDRAWAL=50
MAX_WITHDRAWAL=100000
WITHDRAWAL_COOLDOWN_SECONDS=60

# Game Configuration
MIN_STAKE=10
MAX_STAKE=20000
STAKE_INCREMENT=40
MATCH_DURATION_SECONDS=5
QUEUE_MAX_CAPACITY=500
AUTO_BET_MAX_ROUNDS=10

# Admin Dashboard
ADMIN_EMAIL=admin@simbike.ke
ADMIN_PASSWORD=change_me_in_production

# Logging
LOG_LEVEL=debug
LOG_FILE=./logs/app.log

# Security
RATION_LIMIT_WINDOW_MS=900000
RATION_LIMIT_MAX_REQUESTS=100
CORS_ORIGIN=http://localhost:3000

# Feature Flags
ENABLE_ANALYTICS=true
ENABLE_RESPONSIBLE_GAMING=true
DAILY_LOSS_LIMIT=50000
